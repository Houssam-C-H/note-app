# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://notespace:devpassword@localhost:5432/notespace_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
# Generate secure 256-bit secrets (e.g., using `openssl rand -hex 32`)
AUTH_ACCESS_SECRET=your-access-secret-keep-safe
AUTH_REFRESH_SECRET=your-refresh-secret-keep-safe
AUTH_ACCESS_EXPIRY=15m
AUTH_REFRESH_EXPIRY=7d

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# S3 Storage (Required if STORAGE_DRIVER=s3)
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT=

# Email Configuration (MailHog for local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@notespace.app

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
